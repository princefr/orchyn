{
  "name": "signup",
  "base_url": "",
  "steps": [
    {"actor": "default", "op": "goto", "path": "/"},
    {"actor": "default", "op": "expect_visible", "selector": "#email"},
    {"actor": "default", "op": "expect_visible", "selector": "#submit-btn"},
    {"actor": "default", "op": "expect_all_clickable"},
    {"actor": "default", "op": "expect_console_clean"},
    {"actor": "default", "op": "expect_no_failed_requests"},
    {"actor": "default", "op": "expect_no_text", "text": "Email is required"},
    {"actor": "default", "op": "click", "selector": "#submit-btn"},
    {"actor": "default", "op": "expect_text", "text": "Email is required"},
    {"actor": "default", "op": "expect_visible", "selector": "#email-error"},
    {"actor": "default", "op": "wait_ms", "ms": 800},
    {"actor": "default", "op": "expect_no_failed_requests"},
    {"actor": "default", "op": "expect_no_text", "text": "Check your inbox to confirm."},
    {"actor": "default", "op": "fill", "selector": "#email", "value": "alice@test.com"},
    {"actor": "default", "op": "click", "selector": "#submit-btn"},
    {"actor": "default", "op": "expect_request", "method": "POST", "path_contains": "/api/signup", "status": 201},
    {"actor": "default", "op": "expect_text", "text": "Check your inbox to confirm."},
    {"actor": "default", "op": "expect_no_text", "text": "Email is required"},
    {"actor": "default", "op": "expect_console_clean"},
    {"actor": "default", "op": "click_each"}
  ]
}
