{
  "name": "login",
  "base_url": "",
  "steps": [
    {"actor":"default","op":"goto","path":"/"},
    {"actor":"default","op":"expect_all_clickable"},
    {"actor":"default","op":"expect_console_clean"},
    {"actor":"default","op":"expect_no_failed_requests"},
    {"actor":"default","op":"snapshot_text","key":"before"},
    {"actor":"default","op":"reload"},
    {"actor":"default","op":"expect_text_unchanged","key":"before"},
    {"actor":"default","op":"fill","selector":"#email","value":"alice@test.com"},
    {"actor":"default","op":"fill","selector":"#password","value":"wrong-password"},
    {"actor":"default","op":"click","selector":"#login-btn"},
    {"actor":"default","op":"expect_request","method":"POST","path_contains":"/api/login","status":401},
    {"actor":"default","op":"expect_text","text":"Invalid credentials"},
    {"actor":"default","op":"expect_visible","selector":"#login-btn"},
    {"actor":"default","op":"reset_telemetry"},
    {"actor":"default","op":"fill","selector":"#password","value":"password123"},
    {"actor":"default","op":"click","selector":"#login-btn"},
    {"actor":"default","op":"expect_request","method":"POST","path_contains":"/api/login","status":200},
    {"actor":"default","op":"expect_url","contains":"/dashboard"},
    {"actor":"default","op":"expect_text","text":"Welcome, alice@test.com"},
    {"actor":"default","op":"expect_no_text","text":"Please sign in"},
    {"actor":"default","op":"expect_no_failed_requests"},
    {"actor":"default","op":"expect_console_clean"},
    {"actor":"visitor","op":"goto","path":"/dashboard"},
    {"actor":"visitor","op":"wait_for_text","text":"Please sign in"},
    {"actor":"visitor","op":"expect_no_text","text":"Welcome,"}
  ]
}
