{
  "name": "route-mismatch",
  "base_url": "",
  "steps": [
    {"actor": "default", "op": "goto", "path": "/"},
    {"actor": "default", "op": "expect_text", "text": "Shop items"},
    {"actor": "default", "op": "wait_for_text", "text": "Apples"},
    {"actor": "default", "op": "expect_text", "text": "Apples\nBread"},
    {"actor": "default", "op": "expect_no_text", "text": "No items"},
    {"actor": "default", "op": "expect_visible", "selector": "#items"},
    {"actor": "default", "op": "expect_request", "method": "GET", "path_contains": "/api/items", "status": 200},
    {"actor": "default", "op": "expect_console_clean"},
    {"actor": "default", "op": "expect_no_failed_requests"},
    {"actor": "default", "op": "expect_all_clickable"},
    {"actor": "default", "op": "snapshot_text", "key": "before"},
    {"actor": "default", "op": "reload"},
    {"actor": "default", "op": "wait_for_text", "text": "Bread"},
    {"actor": "default", "op": "expect_text_unchanged", "key": "before"},
    {"actor": "viewer", "op": "goto", "path": "/"},
    {"actor": "viewer", "op": "wait_for_text", "text": "Apples\nBread"},
    {"actor": "viewer", "op": "expect_console_clean"},
    {"actor": "default", "op": "click_each"}
  ]
}
