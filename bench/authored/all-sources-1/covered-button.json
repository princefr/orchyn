{
  "name": "covered-button",
  "base_url": "",
  "steps": [
    {"op": "goto", "path": "/"},
    {"op": "expect_console_clean"},
    {"op": "expect_no_failed_requests"},
    {"op": "expect_visible", "selector": "#subscribe"},
    {"op": "expect_all_clickable"},
    {"op": "expect_no_text", "text": "Subscribed!"},
    {"op": "snapshot_text", "key": "before"},
    {"op": "reload"},
    {"op": "expect_text_unchanged", "key": "before"},
    {"op": "click", "selector": "#subscribe"},
    {"op": "expect_text", "text": "Subscribed!"},
    {"op": "expect_visible", "selector": "#status"},
    {"op": "wait_ms", "ms": 800},
    {"op": "expect_text", "text": "Subscribed!"},
    {"op": "click_each", "selector": "#subscribe"},
    {"op": "expect_console_clean"},
    {"op": "expect_no_failed_requests"}
  ]
}
