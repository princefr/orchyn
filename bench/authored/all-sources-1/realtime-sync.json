{
  "name": "realtime-sync",
  "base_url": "",
  "steps": [
    {"op": "goto", "path": "/"},
    {"op": "wait_ms", "ms": 800},
    {"op": "expect_console_clean"},
    {"op": "expect_no_failed_requests"},
    {"op": "expect_visible", "selector": "#note"},
    {"op": "expect_all_clickable"},
    {"actor": "bob", "op": "goto", "path": "/"},
    {"actor": "bob", "op": "wait_ms", "ms": 800},
    {"op": "fill", "selector": "#note", "value": "hello team"},
    {"op": "click", "selector": "#post-btn"},
    {"op": "expect_request", "method": "POST", "path_contains": "/api/notes", "status": 201},
    {"op": "expect_visible", "selector": "#board .note"},
    {"op": "expect_text", "text": "hello team"},
    {"actor": "bob", "op": "expect_text", "text": "hello team", "timeout_ms": 5000},
    {"op": "snapshot_text", "key": "board"},
    {"op": "fill", "selector": "#note", "value": "   "},
    {"op": "click", "selector": "#post-btn"},
    {"op": "wait_ms", "ms": 1200},
    {"op": "expect_text_unchanged", "key": "board"},
    {"op": "reload"},
    {"op": "wait_ms", "ms": 800},
    {"op": "expect_text_unchanged", "key": "board"},
    {"op": "expect_no_failed_requests"}
  ]
}
