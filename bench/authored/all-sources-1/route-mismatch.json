{
  "name": "route-mismatch",
  "base_url": "",
  "steps": [
    {"op": "goto", "path": "/"},
    {"op": "wait_for_text", "text": "Apples", "timeout_ms": 5000},
    {"op": "expect_console_clean"},
    {"op": "expect_no_failed_requests"},
    {"op": "expect_visible", "selector": "#items"},
    {"op": "expect_text", "text": "Shop items"},
    {"op": "expect_text", "text": "Apples"},
    {"op": "expect_text", "text": "Bread"},
    {"op": "expect_no_text", "text": "No items"},
    {"op": "expect_request", "method": "GET", "path_contains": "/api/items"},
    {"op": "expect_all_clickable"},
    {"op": "snapshot_text", "key": "list"},
    {"op": "reload"},
    {"op": "wait_for_text", "text": "Apples", "timeout_ms": 5000},
    {"op": "expect_text_unchanged", "key": "list"}
  ]
}
