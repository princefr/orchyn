{
  "name": "notes",
  "base_url": "",
  "steps": [
    {"actor": "alice", "op": "goto", "path": "/"},
    {"actor": "alice", "op": "fill", "selector": "#note", "value": "First note"},
    {"actor": "alice", "op": "click", "selector": "#post-btn"},
    {"actor": "alice", "op": "expect_request", "method": "POST", "path_contains": "/api/notes", "status": 201},
    {"actor": "alice", "op": "expect_text", "text": "First note"},
    {"actor": "bob", "op": "goto", "path": "/"},
    {"actor": "bob", "op": "expect_text", "text": "First note"},
    {"actor": "bob", "op": "fill", "selector": "#note", "value": "Second note from bob"},
    {"actor": "bob", "op": "click", "selector": "#post-btn"},
    {"actor": "bob", "op": "expect_text", "text": "First note\nSecond note from bob"},
    {"actor": "alice", "op": "expect_text", "text": "First note\nSecond note from bob"},
    {"actor": "alice", "op": "fill", "selector": "#note", "value": "Third note"},
    {"actor": "alice", "op": "click", "selector": "#post-btn"},
    {"actor": "bob", "op": "expect_text", "text": "First note\nSecond note from bob\nThird note"},
    {"actor": "alice", "op": "expect_console_clean"},
    {"actor": "bob", "op": "expect_console_clean"},
    {"actor": "alice", "op": "expect_no_failed_requests"},
    {"actor": "bob", "op": "expect_no_failed_requests"}
  ]
}
