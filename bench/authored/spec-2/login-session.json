{
  "name": "login-session",
  "base_url": "",
  "steps": [
    {"op": "goto", "path": "/"},
    {"op": "fill", "selector": "#email", "value": "alice@test.com"},
    {"op": "fill", "selector": "#password", "value": "password123"},
    {"op": "click", "selector": "#login-btn"},
    {"op": "expect_text", "text": "Welcome, alice@test.com"},
    {"op": "expect_url", "contains": "/dashboard"},
    {"op": "expect_visible", "selector": "#greeting"},
    {"op": "expect_request", "method": "POST", "path_contains": "/api/login"},
    {"op": "expect_console_clean"},
    {"op": "expect_no_failed_requests"},
    {"actor": "eve", "op": "goto", "path": "/"},
    {"actor": "eve", "op": "fill", "selector": "#email", "value": "alice@test.com"},
    {"actor": "eve", "op": "fill", "selector": "#password", "value": "wrong-password"},
    {"actor": "eve", "op": "click", "selector": "#login-btn"},
    {"actor": "eve", "op": "expect_text", "text": "Invalid credentials"},
    {"actor": "eve", "op": "expect_visible", "selector": "#error"},
    {"actor": "eve", "op": "expect_request", "method": "POST", "path_contains": "/api/login"},
    {"actor": "guest", "op": "goto", "path": "/dashboard"},
    {"actor": "guest", "op": "expect_text", "text": "Please sign in"}
  ]
}
